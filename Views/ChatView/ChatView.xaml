<UserControl x:Class="NetEase.Views.Pages.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NetEase.Views.Pages"
             xmlns:viewmodels="clr-namespace:NetEase.ViewModels" 
             xmlns:chatviewmodels="clr-namespace:NetEase.ViewModels.ChatViewModels"
             xmlns:converters="clr-namespace:NetEase.Converters"
             d:DataContext="{d:DesignInstance Type=chatviewmodels:ChatViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
        <BitmapImage x:Key="DefaultAvatarImage" UriSource="/CoverImage/28.jpg" />
    </UserControl.Resources>
    <Grid Background="White"
          ShowGridLines="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <!-- 第一栏：会话列表 -->
            <ColumnDefinition Width="*"/>
            <!-- 第二栏：聊天窗口 -->
        </Grid.ColumnDefinitions>

        <!-- ======================= 第一栏：会话列表 ======================= -->
        <Border Grid.Column="0"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBox DockPanel.Dock="Top"
                         Text="搜索"
                         Margin="10"
                         Padding="5"/>
                <ListBox ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}"
                         HorizontalContentAlignment="Stretch"
                         BorderThickness="0" 
                         d:ItemsSource="{d:SampleData ItemCount=4}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 头像区域，我们将在这里叠加红点 -->
                                <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,10,0">
                                    <!-- 1. 头像 Ellipse (保持不变) -->
                                    <Ellipse>
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatarImage}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- 2. 【新增】红点和数字 (Border + TextBlock) -->
                                    <!-- 默认是隐藏的 -->
                                    <Border Background="Red" 
                                        CornerRadius="9" 
                                        Height="18" 
                                        Width="18"
                                        Padding="4"
                                        HorizontalAlignment="Right" 
                                        VerticalAlignment="Top"
                                        Margin="0,-5,-5,0">
                                        <!-- 使用负边距将红点定位到右上角 -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- 默认隐藏 -->
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UnreadMessageCount}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <TextBlock Text="{Binding UnreadMessageCount}" 
                           Foreground="White"
                           FontSize="10"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ======================= 第二栏：聊天窗口 ======================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 标题栏 -->
                <RowDefinition Height="*"/>
                <!-- 消息列表 -->
            </Grid.RowDefinitions>
           
            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Padding="10"
                    BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="{Binding SelectedSession.Name}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="&#xE7C3;"
                                FontFamily="Segoe MDL2 Assets"
                                Margin="5,0"/>
                        <Button Content="&#xE713;"
                                FontFamily="Segoe MDL2 Assets"
                                Margin="5,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1"
                  ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" ShowGridLines="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0"
                                  Padding="10">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 根 Grid，负责整体左右对齐 -->
                                    <Grid Margin="0,10" ShowGridLines="True">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="HorizontalAlignment"
                                                        Value="Left"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSentByMe}"
                                                                 Value="True">
                                                        <Setter Property="HorizontalAlignment"
                                                                Value="Right"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid ShowGridLines="True">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 1. 别人的头像 (始终在第 0 列) -->
                                            <Ellipse Grid.Column="0"
                                                     Width="32"
                                                     Height="32"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSentByMe}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatarImage}}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>

                                            <!-- 2. 消息内容 (StackPanel) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                             

                                                <!-- 发送者名称 -->
                                                <TextBlock Text="{Binding SenderName}"
                                                           Foreground="Gray"
                                                           FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment"
                                                                    Value="Left"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSentByMe}"
                                                                             Value="True">
                                                                    <Setter Property="HorizontalAlignment"
                                                                            Value="Right"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- 消息气泡 -->
                                                <Border CornerRadius="8"
                                                        Padding="12"
                                                        Margin="0,5,0,0"
                                                        MaxWidth="400">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background"
                                                                    Value="#EEE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSentByMe}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#007BFF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Content}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="Black"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSentByMe}"
                                                                                 Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="White"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                        <Image Source="{Binding ImageData, FallbackValue={x:Null}}" MaxHeight="200" Stretch="Uniform">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Image">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                    </Grid>
</Border>
                                                <TextBlock Text="已读" FontSize="11" Foreground="Gray" Margin="0,4,8,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <!-- 默认隐藏 -->
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <!-- 只在我发送的、并且已被读取的消息下方显示 -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSentByMe}" Value="True"/>
                                                                        <Condition Binding="{Binding IsRead}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- 3. 我方的头像 (始终在第 1 列) -->
                                            <Ellipse Grid.Column="2"
                                                     Width="32"
                                                     Height="32"
                                                     Margin="10,0,0,0"
                                                     VerticalAlignment="Top">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSentByMe}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatarImage}}"/>
                                                </Ellipse.Fill>
                                            </Ellipse>


                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
                        <Grid ShowGridLines="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- 工具栏，比如表情、文件按钮 -->
                                <RowDefinition Height="*"/>
                                <!-- 文本输入框 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 发送按钮 -->
                            </Grid.RowDefinitions>

                            <!-- 1. 工具栏 -->
                            <ItemsControl Grid.Row="0" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <!-- 为工具栏按钮创建一个通用样式 -->
                                <ItemsControl.Resources>
                                    <Style x:Key="ToolBarButtonStyle" TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="#666666"/>
                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Margin" Value="3,0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3">
                                                        <TextBlock Text="{TemplateBinding Content}" 
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Resources>

                                <!-- 定义工具栏按钮 -->
                                <Button Content="&#xE76E;" Style="{StaticResource ToolBarButtonStyle}" ToolTip="表情"/>
                                <Button Content="&#xE74E;" Style="{StaticResource ToolBarButtonStyle}" ToolTip="截图"/>
                                <Button Content="&#xE8B5;" 
                                        Style="{StaticResource ToolBarButtonStyle}" 
                                        ToolTip="发送图片"
                                        Command="{Binding SendImageCommand}"/>
                                <Button Content="&#xE8DA;" Style="{StaticResource ToolBarButtonStyle}" ToolTip="文件夹"/>
                                <Button Content="&#xE8C8;" Style="{StaticResource ToolBarButtonStyle}" ToolTip="历史记录"/>
                                <Button Content="&#xE717;" Style="{StaticResource ToolBarButtonStyle}" ToolTip="语音通话"/>
                                <Button Content="&#xE714;" Style="{StaticResource ToolBarButtonStyle}" ToolTip="视频通话"/>
                                <Button Content="..." Style="{StaticResource ToolBarButtonStyle}" FontFamily="Arial" FontSize="14" Padding="8,5"/>
                                <Button Content="&#xE70B;" Style="{StaticResource ToolBarButtonStyle}" HorizontalAlignment="Right" Margin="10,0,0,0" ToolTip="消息设置"/>

                            </ItemsControl>

                            <!-- 2. 文本输入框 -->
                            <TextBox Grid.Row="1" 
                                     Text="{Binding NewMessageText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0"
                                     MinHeight="60"
                                     VerticalContentAlignment="Top"/>

                            <!-- 3. 发送按钮 -->
                            <Button Grid.Row="2" 
                                    Content="发送(S)"
                                    Background="Aqua"
                                    Command="{Binding SendMessageCommand}"
                                    HorizontalAlignment="Right"
                                    Padding="15, 5"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- 标题栏 -->
                        <RowDefinition Height="*"/>
                        <!-- 消息列表 -->
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"
                                Margin="15">
                        <TextBlock Text="群公告"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="APEX 账号大全..."
                                   Margin="0,5,0,20"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Margin="15">
                        <TextBlock Text="群成员 (3/12)"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Members}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0"
                                                 Width="24"
                                                 Height="24"
                                                 Margin="0,0,10,0">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatarImage}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
