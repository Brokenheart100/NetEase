<UserControl x:Class="NetEase.Views.Components.UserProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:NetEase.Views.Components"
             xmlns:viewmodels="clr-namespace:NetEase.ViewModels"
             xmlns:converters="clr-namespace:NetEase.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:UserProfileViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="1000">

    <UserControl.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <BitmapImage x:Key="DefaultAvatarImage"
                     UriSource="/CoverImage/28.jpg"/>
        <!-- “立即签到” 按钮的样式 -->
        <Style x:Key="SignInButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E54D42"/>
            <Setter Property="BorderBrush" Value="#E54D42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15, 5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33E54D42"/>
                    <!-- 鼠标悬浮时给一个淡淡的背景 -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- “去补签” 链接按钮的样式 -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5E87A9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
           
        </Style>
        <!-- 数字的样式 -->
        <Style x:Key="StatNumberStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="20"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 标签的样式 (动态, 关注...) -->
        <Style x:Key="StatLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="Foreground"
                    Value="#888888"/>
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
        </Style>

        <!-- 菜单项按钮的样式 -->
        <Style x:Key="MenuButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Foreground"
                    Value="#DDDDDD"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Padding"
                    Value="10, 12"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Background"
                                        Value="#3F3F3F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="VerticalSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    
    <Border Width="320"
            Background="#2C2C2C"
            CornerRadius="8"
            Padding="20">
        <StackPanel>
            <!-- 1. 顶部用户信息 -->
            <Grid ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" 
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" 
                Command="{Binding ChangeAvatarCommand}"
                ToolTip="点击更换头像"
                Cursor="Hand">

                    <Ellipse Width="48" Height="48">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatarImage}}"/>
                        </Ellipse.Fill>
                    </Ellipse>

                </Button>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="15,0">
                    <TextBlock Text="{Binding UserName}"
                               Foreground="White"
                               FontSize="16"/>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="Gray"
                                CornerRadius="8"
                                Padding="5,2">
                            <TextBlock Text="VIP"
                                       Foreground="White"
                                       FontSize="10"/>
                        </Border>
                        <TextBlock Text="{Binding VipInfo}"
                                   Foreground="Gold"
                                   Margin="5,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2"
                        Content=">"
                        Foreground="Gray"
                        Background="Transparent"
                        BorderThickness="0"/>
            </Grid>

            <!-- 2. 统计数据 -->
            <UniformGrid Rows="1"
                         Margin="0,20">
                <!-- 动态 -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DynamicCount}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="动态"
                               Foreground="Gray"/>
                </StackPanel>
                <!-- 关注 -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FollowingCount}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="关注"
                               Foreground="Gray"/>
                </StackPanel>
                <!-- 粉丝 -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FollowerCount}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="粉丝"
                               Foreground="Gray"/>
                </StackPanel>
                <!-- 等级 -->
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Level}"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="等级"
                               Foreground="Gray"/>
                </StackPanel>
            </UniformGrid>

            <!-- 3. 每日签到 -->
            <Border Background="#383838"
                    CornerRadius="8"
                    Padding="15">
                <Grid ShowGridLines="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="每日签到"
                                       Foreground="White"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Foreground="#888"
                                   FontSize="12"
                                   Margin="0,5,0,10">
                            <Run Text="再连续签到"/>
                            <Run Text="{Binding ConsecutiveSignInDays}"
                                 Foreground="#E54D42"/>
                            <Run Text="天, 可领取奖励"/>
                            <Button Content="去补签"
                                    Style="{StaticResource LinkButtonStyle}"/>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding SignInProgress}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <!-- 节点图标 -->
                                        <Border Width="30" Height="30" CornerRadius="15" Background="#555">
                                            <!-- 这里可以根据 IsCompleted 状态改变图标或背景 -->
                                            <!-- 也可以根据 IsSpecialReward 显示特殊图标 -->
                                        </Border>
                                        <!-- 节点标签 -->
                                        <TextBlock Text="{Binding DayLabel}" Foreground="#888" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding SignInCommand}"
                                           Content="立即签到"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource SignInButtonStyle}"/>
                </Grid>
            </Border>

            <!-- 4. 菜单列表 -->
            <ItemsControl ItemsSource="{Binding MenuItems1}"
                          Margin="0,15,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource MenuButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontFamily="Segoe MDL2 Assets"
                                           VerticalAlignment="Center"
                                           Margin="0,0,15,0"/>

                                <!-- Text and Notifications -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Text}"/>
                                    <!-- 红点通知 -->
                                    <Ellipse Fill="Red"
                                             Width="6"
                                             Height="6"
                                             Margin="5,0,0,5"
                                             Visibility="{Binding HasNotification, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <!-- 数字通知 -->
                                    <Border Background="Red"
                                            CornerRadius="7"
                                            MinWidth="14"
                                            Height="14"
                                            Padding="3,0"
                                            Margin="5,0,0,0"
                                            Visibility="{Binding NotificationCount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                        <TextBlock Text="{Binding NotificationCount}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- SubText and Arrow -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SubText}"
                                               Foreground="#888"
                                               FontSize="12"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="&#xE097;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="#888"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 5. 分割线 -->
            <Separator Background="#444"
                       Margin="0,10"/>

            <!-- 6. 切换账号 & 退出登录 -->
            <StackPanel>
                <Button Style="{StaticResource MenuButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Icon -->
                        <TextBlock Text="&#xE8D5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Margin="0,0,15,0"/>
                        <TextBlock Text="切换账号"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Icon -->
                        <TextBlock Text="&#xE7E8;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Margin="0,0,15,0"/>
                        <TextBlock Text="退出登录"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
