<UserControl x:Class="NetEase.Views.PlaylistViews.CommentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetEase.Views.PlaylistViews" 
             xmlns:behaviors="clr-namespace:NetEase.Behaviors"
             xmlns:playlistviewmodels="clr-namespace:NetEase.ViewModels.PlaylistViewModels" 
             xmlns:converters="clr-namespace:NetEase.Converters"
             xmlns:viewModels="clr-namespace:NetEase.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" 
             d:DataContext="{d:DesignInstance Type=playlistviewmodels:CommentViewModel}"
                >

    <UserControl.Resources>
        <BitmapImage x:Key="DefaultAvatarImage" UriSource="/CoverImage/32.jpg" />
        <converters:InvertValueConverter x:Key="InvertValueConverter"/>
        <converters:NegativeMarginConverter x:Key="NegativeMarginConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
        <behaviors:BindingProxy x:Key="Proxy" Data="{Binding}"/>

        <LinearGradientBrush x:Key="ProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#4A8FFF" Offset="0"/>
            <GradientStop Color="#0066FF" Offset="1"/>
        </LinearGradientBrush>
        <!-- 方案C: 环形旋转加载样式 -->
        <Style x:Key="CircularSpinnerProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <!-- 使用 Path 绘制一个圆环 -->
                            <Path Stroke="#EC4141" StrokeThickness="4" StrokeDashArray="2, 2">
                                <Path.Data>
                                    <!-- 几何图形：一个中心在(25,25)，半径为20的圆 -->
                                    <EllipseGeometry Center="25,25" RadiusX="20" RadiusY="20"/>
                                </Path.Data>
                                <Path.RenderTransform>
                                    <RotateTransform CenterX="25" CenterY="25"/>
                                </Path.RenderTransform>
                            </Path>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsIndeterminate" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- 动画：让圆环无限旋转 -->
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0"
                                                     To="360"
                                                     Duration="0:0:1"
                                                     RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconButtonStyle"
            TargetType="Button">
            <Setter Property="Background"
        Value="Transparent"/>
            <Setter Property="Foreground"
        Value="#CCCCCC"/>
            <Setter Property="BorderThickness"
        Value="0"/>
            <Setter Property="Width"
        Value="32"/>
            <Setter Property="Height"
        Value="32"/>
            <Setter Property="FontSize"
        Value="18"/>
            <Setter Property="FontFamily"
        Value="Segoe Fluent Icons"/>
            <Setter Property="Cursor"
        Value="Hand"/>
            <Setter Property="Margin"
        Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 我们需要一个模板来确保背景真正受我们控制 -->
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
             Value="True">
                    <Setter Property="Foreground"
                Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChIconButtonStyle"
    TargetType="Button">
            <Setter Property="Background"
Value="Transparent"/>
            <Setter Property="Foreground"
Value="#CCCCCC"/>
            <Setter Property="BorderThickness"
Value="0"/>
            <Setter Property="Width"
Value="32"/>
            <Setter Property="Height"
Value="32"/>
            <Setter Property="FontSize"
Value="18"/>
            <Setter Property="Cursor"
Value="Hand"/>
            <Setter Property="Margin"
Value="0,0,1,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 我们需要一个模板来确保背景真正受我们控制 -->
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
     Value="True">
                    <Setter Property="Foreground"
        Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="CommentItemTemplate">
            <Grid Margin="0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 头像 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 内容 -->
                </Grid.ColumnDefinitions>

                <!-- 左侧头像 -->
                <Ellipse Grid.Column="0" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,15,0">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding AvatarUrl, FallbackValue={StaticResource DefaultAvatarImage}}"/>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 右侧评论详情 -->
                <StackPanel Grid.Column="1">
                    <!-- 用户名、VIP标识、评论内容 -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" Foreground="#5E87A9" Cursor="Hand"/>
                            <Border Background="#444" CornerRadius="8" Padding="4,1" Margin="8,0"
                                    Visibility="{Binding IsVip, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="VIP·陆" FontSize="9" Foreground="Gold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="#DDDDDD" Margin="0,8,0,0" LineHeight="22"/>
                    </StackPanel>

                    <!-- 发布时间 和 操作按钮 -->
                    <Grid Margin="10">
                        <TextBlock Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd'}" Foreground="#666666" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding LikeCount}" Foreground="#888" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <Button Content="&#xe8e1;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource IconButtonStyle}" ToolTip="赞" Foreground="#888" Width="24" Height="24"/>
                            <Button Content="&#xe72d;" Style="{StaticResource IconButtonStyle}" ToolTip="回复" Foreground="#888" Width="24" Height="24"/>
                            <Button Content="&#xe90a;" Style="{StaticResource IconButtonStyle}" ToolTip="回复" Foreground="#888" Width="24" Height="24"/>
                        </StackPanel>
                    </Grid>

                    <!-- 分割线 -->
                    <Separator Background="#3A3A3B" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <Style x:Key="ModernDataGridStyle" TargetType="{x:Type DataGrid}">
            <!-- 基础属性设置 (从您原来的 DataGrid 标签上移到这里) -->
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>

            <!-- 
    ================== 关键修改点 ==================
    重写 ControlTemplate 来替换内部的 ScrollViewer 样式
-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGrid}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    Background="{TemplateBinding Background}" 
                    Padding="{TemplateBinding Padding}" 
                    SnapsToDevicePixels="True">

                            <!-- 
                    找到 DataGrid 内部的 ScrollViewer (它的名字是 PART_RowsPresenter)，
                    并将它的 Style 设置为我们的 ModernScrollViewerStyle。
                -->
                            <ScrollViewer x:Name="PART_RowsPresenter" 
                              Style="{StaticResource for_scrollviewer}"
                              Focusable="False">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ScrollViewer 样式 -->
        <Style x:Key="ModernScrollViewer"
           TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 内容呈现 -->
                            <ScrollContentPresenter Grid.Column="0"
                                                Grid.Row="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"
                                                Content="{TemplateBinding Content}"/>
                            <!-- 垂直滚动条 -->
                            <ScrollBar Grid.Column="1"
                                   Grid.Row="0"
                                   Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <!-- 水平滚动条 -->
                            <ScrollBar Grid.Column="0"
                                   Grid.Row="1"
                                   Name="PART_HorizontalScrollBar"
                                   Orientation="Horizontal"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <!-- 右下角填充（可选） -->
                            <Rectangle Grid.Column="1"
                                   Grid.Row="1"
                                   Fill="LightGray"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 自定义 ScrollViewer 的额外属性 -->
            <Setter Property="Background"
                Value="White"/>
            <Setter Property="BorderBrush"
                Value="Gray"/>
            <Setter Property="BorderThickness"
                Value="1"/>
        </Style>

        <!-- 定义按钮样式 -->
        <Style x:Key="ActionButtonStyle"
           TargetType="Button">
            <Setter Property="Foreground"
                Value="White"/>
            <Setter Property="BorderThickness"
                Value="1"/>
            <Setter Property="BorderBrush"
                Value="#555555"/>
            <Setter Property="Background"
                Value="#333333"/>
            <Setter Property="Padding"
                Value="8,8"/>
            <Setter Property="Margin"
                Value="0,0,10,0"/>
            <Setter Property="Cursor"
                Value="Hand"/>
            <Setter Property="Height"
                Value="40"/>
            <Setter Property="Width"
                Value="80"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayAllButtonStyle"
           BasedOn="{StaticResource ActionButtonStyle}"
           TargetType="Button">
            <Setter Property="Background"
                Value="#EC4141"/>
            <Setter Property="BorderBrush"
                Value="Transparent"/>
        </Style>

        <!-- ================== 自定义 ListView 列标题样式 ================== -->
        <Style x:Key="CustomColumnHeaderStyle"
           TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background"
                Value="Transparent"/>
            <Setter Property="Foreground"
                Value="#888888"/>
            <Setter Property="BorderThickness"
                Value="0,0,1,1"/>
            <Setter Property="BorderBrush"
                Value="#333333"/>
            <Setter Property="Padding"
                Value="10,5"/>
            <Setter Property="HorizontalContentAlignment"
                Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Grid>
                            <!-- 1. 正常状态下显示的内容 -->
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                            </Border>

                            <!-- 2. 悬浮时才显示的内容 (初始不可见) -->
                            <Border x:Name="HoverContent"
                                Background="#3A3A3B"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="4"
                                Opacity="0">
                                <StackPanel Orientation="Horizontal">
                                    <!-- 排序图标 -->
                                    <TextBlock Text="&#xE8CB;"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                    <!-- 排序文字 -->
                                    <TextBlock Text="默认排序"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- 当鼠标悬浮在列标题上时 -->
                            <Trigger Property="IsMouseOver"
                                 Value="True">
                                <Setter Property="Foreground"
                                    Value="#CCCCCC"/>
                                <!-- 使用动画让悬浮内容淡入 -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverContent"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverContent"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <!-- ================== 1. 自定义 TabItem 样式 ================== -->
        <Style x:Key="CustomTabItemStyle"
           TargetType="{x:Type TabItem}">
            <Setter Property="Width"
                Value="70"/>
            <Setter Property="Foreground"
                Value="#888888"/>
            <Setter Property="FontSize"
                Value="15"/>
            <Setter Property="Padding"
                Value="10,10,10,10"/>
            <Setter Property="Margin"
                Value="0,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <!-- 内容行 -->
                                <RowDefinition Height="Auto"/>
                                <!-- 指示器行 -->
                            </Grid.RowDefinitions>

                            <!-- 头部内容 -->
                            <ContentPresenter x:Name="ContentSite"
                                          Grid.Row="0"
                                          ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                            <!-- 选中时的红色下划线指示器 -->
                            <Border x:Name="SelectionIndicator"
                                Grid.Row="1"
                                Background="#EC4141"
                                Height="3"
                                Margin="0,0,0,0"
                                Visibility="Collapsed"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                 Value="True">
                                <Setter Property="Foreground"
                                    Value="White"/>
                                <Setter Property="FontWeight"
                                    Value="Bold"/>
                                <Setter TargetName="SelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected"
                                           Value="False"/>
                                    <Condition Property="IsMouseOver"
                                           Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground"
                                    Value="#BBBBBB"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================== 2. 自定义 TabControl 样式 ================== -->
        <Style x:Key="CustomTabControlStyle"
           TargetType="{x:Type TabControl}">
            <Setter Property="BorderThickness"
                Value="0"/>
            <Setter Property="Background"
                Value="Transparent"/>
            <Setter Property="Padding"
                Value="0,0,0,10"/>
        </Style>
        <!-- ================== 自定义 ContextMenu 样式 ================== -->
        <!-- MenuItem 的样式 -->
        <Style x:Key="ModernMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" 
                    Background="{TemplateBinding Background}" 
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- IconPresenter 用于显示 MenuItem 的 Icon -->
                                <ContentPresenter x:Name="Icon" Grid.Column="0" 
                                      Content="{TemplateBinding Icon}"
                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <!-- Header (文字) -->
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬浮时高亮 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F3F"/>
                                <Setter Property="Foreground" Value="AntiqueWhite"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ContextMenu 的样式 -->
        <Style x:Key="ModernContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- 将我们创建的 MenuItem 样式应用到其所有子项 -->
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernMenuItemStyle}"/>
        </Style>



    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource for_scrollviewer}">
        <StackPanel Margin="30,20">
            <TextBlock Text="全部评论" FontSize="18" FontWeight="Bold" Foreground="White"/>

            <!-- 1. 评论输入区 -->
            <Border BorderBrush="#3A3A3B" BorderThickness="1" CornerRadius="8" Padding="1">
                <Grid Margin="0,20" ShowGridLines="True">
                    <TextBox Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" AcceptsReturn="True"
                 MinHeight="100" Padding="15"
                 VerticalScrollBarVisibility="Auto" HorizontalAlignment="Right" Margin="0,25,5,15" Width="716">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Background" Value="#2A2A2D"/>
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="CaretBrush" Value="White"/>
                                <Setter Property="Margin" Value="15,5,5,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ScrollViewer x:Name="PART_ContentHost" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left" AlignmentY="Top">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="说点什么吧" Foreground="#666666" Margin="5"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- 底部操作栏 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="15">
                        <TextBlock Text="{Binding CharacterCount}" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Button Content="@" Style="{StaticResource ChIconButtonStyle}" Foreground="#666" Width="24" Height="24"/>
                        <Button Content="#" Style="{StaticResource ChIconButtonStyle}" Foreground="#666" Width="24" Height="24"/>
                        <Button Content="🙂" Style="{StaticResource IconButtonStyle}" Foreground="#666" Width="24" Height="24" FontFamily="Segoe UI Emoji"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
                        <Button Content="发布" Style="{StaticResource ActionButtonStyle}" Padding="20,5" Command="{Binding PostCommentCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- 2. "精彩评论" 标题 -->
            <TextBlock Text="精彩评论" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,30,0,15"/>

            <!-- 3. 评论列表区 -->
            <ItemsControl ItemsSource="{Binding Comments}" 
                          ItemTemplate="{StaticResource CommentItemTemplate}"
                          d:ItemsSource="{d:SampleData ItemCount=1}"/>

            <!-- 3. 空状态/加载状态提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding Comments.Count}" Value="0"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Image Source="/CoverImage/25.jpg" Width="120"/>
                <TextBlock Text="等评论..." Foreground="#888" Margin="0,20,0,5" HorizontalAlignment="Center"/>
                <TextBlock Text="没人来撩一下我吗？" Foreground="#666" HorizontalAlignment="Center"/>
            </StackPanel>

            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Style="{StaticResource CircularSpinnerProgressBarStyle}"
                         Width="50" Height="50" HorizontalAlignment="Center" Margin="10">

            </ProgressBar>

        </StackPanel>
    </ScrollViewer>
</UserControl>
