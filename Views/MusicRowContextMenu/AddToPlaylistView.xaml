<Window x:Class="NetEase.Views.MusicRowContextMenu.AddToPlaylistView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NetEase.Views.MusicRowContextMenu" 
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:musicrowcontextmenu="clr-namespace:NetEase.ViewModels.MusicRowContextMenu" 
        d:DataContext="{d:DesignInstance Type=musicrowcontextmenu:AddToPlaylistViewModel}"
        mc:Ignorable="d"
        Title="AddToPlaylistView"
        Height="450"
        Width="800">
    <Grid Background="#2D2D30" ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <TextBlock Text="收藏到歌单"
                       Foreground="White"
                       FontSize="16"
                       Margin="15"/>
            <Button Content="&#xE8BB;"
                    FontFamily="Segoe MDL2 Assets"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="10"/>
        </Grid>

        <!-- 列表 -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Playlists}"
                 Background="Transparent"
                 d:ItemsSource="{d:SampleData ItemCount=4}"
                 BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="10">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- 鼠标悬浮时高亮 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#3F3F3F"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="60"
                          Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="50"
                                Height="50"
                                CornerRadius="4"
                                Background="#3F3F3F">
                            <TextBlock Text="+"
                                       FontSize="24"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Margin="15,0,0,0">
                            <TextBlock Text="{Binding Title}"
                                       Foreground="White"/>
                            <TextBlock Text="{Binding TrackCount, StringFormat='{}{0}首音乐', FallbackValue='0首音乐'}"
                                       Foreground="#888"
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <!-- 关键交互：当选中项改变时，触发命令 -->
            <b:Interaction.Triggers>
                <b:EventTrigger EventName="SelectionChanged">
                    <b:InvokeCommandAction
                        Command="{Binding AddToPlaylistCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItem}"/>
                </b:EventTrigger>
            </b:Interaction.Triggers>
        </ListBox>

    </Grid>
</Window>
