<UserControl x:Class="NetEase.Views.Pages.SongDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NetEase.Views.Pages" xmlns:viewmodels="clr-namespace:NetEase.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SongDetailViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 当前高亮歌词的样式 -->
        <Style x:Key="CurrentLyricLineStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 普通歌词的样式 -->
        <Style x:Key="NormalLyricLineStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </UserControl.Resources>

    <Border Background="#2B2B2B" CornerRadius="8">
        <Grid>
            <!-- 顶部控制栏 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="15">
                <!-- TODO: 添加返回按钮，绑定到关闭此视图的命令 -->
                <Button Content="&#xE097;" Command="{Binding CloseDetailViewCommand}"/>
            </StackPanel>

            <Grid Margin="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. 左侧：黑胶唱片动画 -->
                <Grid Grid.Column="0">
                    <Path Data="M 20,20 A 15,15 0 0 1 35,35 L 100,100 A 5,5 0 0 1 95,105 L 30,40 A 15,15 0 0 1 20,20 Z"
                          Width="100" 
                          Height="100"
                          Stretch="Uniform"
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Top"
                          Margin="0,50,-20,0"/>

                    <!-- 唱片 (旋转动画) -->
                    <Grid x:Name="VinylDisc" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <!-- 黑胶外圈 -->
                        <Ellipse Stroke="#444" StrokeThickness="30"/>
                        <!-- 专辑封面 -->
                        <Ellipse Width="250" Height="250">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CurrentSong.CoverImageUrl}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                    <!-- 可以在ViewModel的IsPlaying属性变化时，通过DataTrigger启动或暂停旋转动画 -->
                </Grid>

                <!-- 2. 右侧：歌曲信息和歌词 -->
                <StackPanel Grid.Column="1" Margin="30,0,0,0">
                    <!-- 歌曲标题和信息 -->
                    <TextBlock Text="{Binding CurrentSong.Title}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <!-- ... VIP, 本地等标签 ... -->
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentSong.Artist, StringFormat='歌手: {0}'}" Foreground="#A0A0A0"/>

                    <!-- 歌词/百科/推荐 Tabs -->
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,30">
                        <!-- ... Tab按钮 ... -->
                    </StackPanel>

                    <!-- 歌词滚动区域 -->
                    <ScrollViewer Height="300" VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding Lyrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,10">
                                        <!-- 原文歌词 -->
                                        <TextBlock Text="{Binding OriginalText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource NormalLyricLineStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentLine}" Value="True">
                                                            <Setter Property="Style" Value="{StaticResource CurrentLyricLineStyle}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 翻译歌词 -->
                                        <TextBlock Text="{Binding TranslatedText}" Foreground="#666" FontSize="16" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
